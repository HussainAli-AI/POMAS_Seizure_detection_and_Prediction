# Python virtual environments & caches
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Large Preprocessed EEG Datasets (Multi-Gigabyte HDF5 / NPZ)
output/preprocessed/
output/preprocessed_global_v2/
output/labram_preprocessed/
output/*/*.h5
output/*/*.npz
*.h5
*.hdf5
*.npz

# Model weights & large serialized artifacts (>100MB exceeds GitHub push limits)
*.pt
*.pth
*.bin
*.joblib
*.pkl

# Preserved experiment outputs (track reports and metric JSONs, figures, summaries)
!output/*.json
!output/*/*.json
!output/*.pdf
!output/pdf/*.pdf
!output/*.html
!output/figures/*.png
!output/*.csv
!output/*.md
!output/pomas_event_store.db
!output/sample_eeg_traces.npz

# Databases & external models (ignore other databases except pomas_event_store.db)
*.db
!output/pomas_event_store.db
*.sqlite
*.sqlite3
epilepsy_trained_model/

# Temporary files
tmp/
*.log
.DS_Store
Thumbs.db

